{
  "name": "react-korean-manuscript",
  "version": "0.2.3",
  "description": "한국어 원고지 React 컴포넌트 및 유틸리티 / Korean manuscript paper React components and utilities",
  "author": "neohum <neohum77@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/neohum/react-korean-manuscript"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "korean",
    "manuscript",
    "원고지",
    "한국어"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
